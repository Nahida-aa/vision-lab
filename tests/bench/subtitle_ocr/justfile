# subtitle_ocr 三实现（cpp/py/rust）横比基准的本地入口。
# 用法（在 tests/bench/subtitle_ocr/ 下）：
#   just                       # 默认 = 显示任务列表
#   just test                  # 正确性灰盒测试（默认 --impl cpp）
#   just impl=py test          # 指定实现（赋值放 recipe 前）
#   just impl=rust test        # rust 未实现时优雅跳过
#   just bench                 # 性能基准（默认 --dir 批量 + 精确 case）
#   just bench cpp 0           # 切回单帧逐帧模式
#   just impl=py bench         # py 基准（未实现时跳过）
#   just only=ocr-cpp-fps2-so-ts0.45 bench   # 跑指定 label 的精确 case
#   just bench cpp 1 "" 4      # 指定 ORT 线程数（省略则用 cpp 默认 4）
#   just scan-threads          # 扫 2/4/8/16 线程，找本机最优
#   just build                 # 编译本包
#
# ⚠️ 线程数不是越大越好：det 输入小、rec 是逐行小图，算子粒度细，
#    线程超订的调度开销会盖过并行收益。16 核机实测 threads=16 反而比 4 慢
#    （RTF 1.24 vs 0.77~0.93，rec 劣化 5 倍），故 cpp 侧默认值定为 4。
# ⚠️ 跑基准前确认机器空载（loadavg 低）：同参数连跑两轮 RTF 波动可达 22%，
#    负载高时测出的 RTF 没有参考价值。
#
# 说明：正确性测试与性能基准后续会共享抽帧/GT 对齐/JSON 解析等代码，
# 故两者都用 Rust 编写（src/bin/test.rs 与 src/bin/bench.rs），统一在此入口调用。

# 实现选择（默认 cpp）
impl := "cpp"
# --dir 批量模式开关（默认关 = 单帧逐帧；dir=1 开启）
dir := "0"
# 精确 case 的 label（默认空 = 按 fps/text-score/subtitle-only 自动生成）
only := ""

# ---- 默认任务（放首位，确保 `just` 无参即跑 test） ----
default:
    @just list

# ---- 编译 ----
build:
    cargo build -p bench_subtitle_ocr

# ---- 跨包流程例子：subtitle_finder 提关键帧 → subtitle_ocr 识别 → 带时间轴字幕 ----
# 用法：just sf-ocr <video.mp4>（默认 /tmp/clip5s.mp4）
sf-ocr video="/tmp/clip5s.mp4":
    cargo run -p bench_subtitle_ocr --release --bin sf_ocr -- {{video}}

# ---- 正确性灰盒测试 ----
test:
    cargo run -p bench_subtitle_ocr --bin test -- --impl {{impl}}

# ---- 性能基准 ----
# 参数：impl（实现）、dir（1=--dir 批量）、only（指定 label）、threads（ORT 线程数，空=cpp 默认）
bench impl="cpp" dir="1" only="ocr-cpp-fps2-so-ts0.45" threads="":
    cargo run -p bench_subtitle_ocr --bin bench -- \
      --impl {{impl}} \
      {{ if dir == "1" { "--dir" } else { "" } }} \
      {{ if only != "" { "--only " + only } else { "" } }} \
      {{ if threads != "" { "--threads " + threads } else { "" } }}

# ---- 线程数扫描 ----
# 找本机最优 intraOpNumThreads。务必在空载时跑，否则结果不可信。
scan-threads:
    @echo "loadavg: $(cut -d' ' -f1-3 /proc/loadavg)  (偏高则结果不可信)"
    @for n in 2 4 8 16; do \
        echo "--- threads=$n ---"; \
        just bench cpp 1 "ocr-cpp-fps2-so-ts0.45-t$n" $n 2>&1 \
          | grep -E 'det=|RTF=|CER'; \
    done
